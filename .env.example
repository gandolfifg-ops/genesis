# Copy to .env in this repository root (already gitignored):
#   cp .env.example .env
#
# Nothing here is required for the offline fixture demo:
#   uv run school-secretary demo

# --- Telegram (optional) ---
# 1. In Telegram, open @BotFather (https://t.me/BotFather)
# 2. Send /newbot and follow the prompts
# 3. Paste the token BotFather returns:
TELEGRAM_BOT_TOKEN="your_bot_token_here"
# Numeric chat id for unsolicited morning/evening briefings.
# If empty, the bot still responds to you; after you send /start it
# remembers the chat id in data/telegram_chat_id.txt.
TELEGRAM_CHAT_ID=

# --- OpenAI (optional) ---
# Used for Telegram function-calling and richer RAG synthesis.
# If empty, agents use the local/mock path (extractive RAG + templates).
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL=gpt-4o-mini
# OR ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# --- onQ / Brightspace ---
ONQ_BASE_URL=https://onq.queensu.ca

# --- MCP HTTP bind (uncommon port; not 3000/5173/8080) ---
MCP_HOST=127.0.0.1
MCP_PORT=43147

# --- Google Calendar push (optional) ---
# If these three OAuth values are empty, sync writes data/calendar/school-secretary.ics
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- WhatsApp Cloud API (optional; Telegram stays primary) ---
# Without these, `uv run school-secretary whatsapp` still starts a mock webhook on 43148.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_HOST=127.0.0.1
WHATSAPP_WEBHOOK_PORT=43148

# --- Paths (defaults are repo-relative; override in tests) ---
# SCHOOL_SECRETARY_DATA_DIR=data
# SCHOOL_SECRETARY_SESSION_PATH=storage_state.json
