# Copy to .env in this repository root (already gitignored):
#   cp .env.example .env
#
# Loaded automatically by pydantic-settings + python-dotenv.
# Nothing here is required for the offline fixture demo:
#   uv run school-secretary demo

# --- Telegram (optional) ---
# 1. In Telegram, open @BotFather (https://t.me/BotFather)
# 2. Send /newbot and follow the prompts
# 3. Paste the token BotFather returns:
TELEGRAM_BOT_TOKEN="your_bot_token_here"
# Numeric chat id for unsolicited 08:00 / 20:00 / 24h deadline pushes.
# If empty, the bot still responds; after /start it stores the id in
# data/telegram_chat_id.txt.
TELEGRAM_CHAT_ID=

# --- LLM (optional) ---
# Anthropic Claude is preferred for /ask, /briefing, and daily planning.
# If ANTHROPIC_API_KEY is empty, OpenAI is used. If both are empty, agents
# use extractive RAG + templates (demo and pytest stay offline).
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL=gpt-4o-mini

# --- onQ / Brightspace ---
ONQ_BASE_URL=https://onq.queensu.ca

# --- MCP HTTP bind (uncommon port; not 3000/5173/8080) ---
MCP_HOST=127.0.0.1
MCP_PORT=43147

# --- Google Calendar push (optional) ---
# Client id and secret are loaded automatically from this file when present.
# With GOOGLE_OAUTH_REFRESH_TOKEN set, calendar-sync pushes assignment due dates,
# lab slots, and test dates to Google Calendar. If any of the three are missing,
# it writes data/calendar/school-secretary.ics instead (secrets are never printed).
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# --- WhatsApp Cloud API (optional; Telegram stays primary) ---
# Without these, `uv run school-secretary whatsapp` still starts a mock webhook on 43148.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_HOST=127.0.0.1
WHATSAPP_WEBHOOK_PORT=43148

# --- Paths (defaults are repo-relative; override in tests) ---
# SCHOOL_SECRETARY_DATA_DIR=data
# SCHOOL_SECRETARY_SESSION_PATH=storage_state.json
